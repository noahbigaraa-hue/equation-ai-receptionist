    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst callId = typeof input.call_id === 'string' ? input.call_id.trim() : '';\nconst callerPhone = typeof input.caller_phone === 'string' ? input.caller_phone.trim() : '';\nconst appointmentStart = typeof input.appointment_start === 'string' ? input.appointment_start.trim() : '';\nconst consentGranted = input.sms_consent_granted === true;\nconst bookingSucceeded = input.booking_succeeded === true;\nconst phoneIsValid = /^\\+[1-9]\\d{7,14}$/.test(callerPhone);\nconst appointmentDate = new Date(appointmentStart);\nconst appointmentIsValid = appointmentStart !== '' && !Number.isNaN(appointmentDate.getTime());\n\nlet skipReason = '';\nif (!callId) skipReason = 'missing_call_id';\nelse if (!bookingSucceeded) skipReason = 'booking_not_successful';\nelse if (!phoneIsValid) skipReason = callerPhone ? 'invalid_caller_phone' : 'missing_caller_phone';\nelse if (!consentGranted) skipReason = 'sms_consent_not_granted';\nelse if (!appointmentIsValid) skipReason = 'missing_or_invalid_appointment_start';\n\nconst state = $getWorkflowStaticData('global');\nstate.smsByCallId = state.smsByCallId || {};\nif (!skipReason && state.smsByCallId[callId]) skipReason = 'duplicate_call_id';\n\nlet smsBody = '';\nif (!skipReason) {\n  const easternTime = new Intl.DateTimeFormat('en-US', {\n    timeZone: 'America/New_York',\n    weekday: 'long',\n    month: 'long',\n    day: 'numeric',\n    hour: 'numeric',\n    minute: '2-digit',\n    hour12: true,\n  }).format(appointmentDate);\n  smsBody = `Wondora Brands: Your consultation is booked for ${easternTime} Eastern. Reply STOP to unsubscribe.`;\n  state.smsByCallId[callId] = {\n    status: 'claimed',\n    claimed_at: new Date().toISOString(),\n    caller_phone: callerPhone,\n    appointment_start: appointmentStart,\n  };\n}\n\nconst consentTimestamp = input.sms_consent_timestamp || '';\nconst consentRecord = JSON.stringify({\n  call_id: callId,\n  caller_phone: callerPhone,\n  consent_granted: consentGranted,\n  consent_timestamp: consentTimestamp,\n  appointment_start: appointmentStart,\n  source: input.sms_consent_source || 'voice_call',\n  evidence: input.sms_consent_evidence || '',\n  original_message: input.message || '',\n  sms_eligible: !skipReason,\n  sms_skip_reason: skipReason,\n});\n\nreturn [{ json: {\n  ...input,\n  sms_eligible: !skipReason,\n  sms_skip_reason: skipReason,\n  sms_body: smsBody,\n  sms_consent_record: consentRecord,\n} }];"
      },
